---
import Layout from "../layouts/Layout.astro";
---

<Layout>
<main>

<!-- HERO -->
<section class="hero" id="home">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-content">
    <p class="hero-greeting">// what's out there?</p>
    <h1>I'm <span class="name">Marco Ceci</span></h1>
    <div class="hero-role">
      <span id="typewriter"></span><span class="cursor"></span>
    </div>
    <p class="hero-sub">
      Web developer and IT specialist based in Latina, Italy. I build production web applications and manage IT infrastructure — 3+ years of professional experience, including a document management system currently running in the chemical and pharmaceutical sector.
    </p>
    <div class="hero-buttons">
      <a href="#projects" class="btn btn-primary">View Projects</a>
      <a href="https://github.com/marcoceci00" target="_blank" rel="noopener noreferrer" class="btn btn-outline">GitHub ↗</a>
    </div>
  </div>
  <div class="hero-scroll" aria-hidden="true">
    <div class="scroll-line"></div>
    explore
  </div>
</section>

<!-- ABOUT -->
<section id="about">
  <div class="container">
    <div class="about-grid">
      <div class="about-text reveal">
        <p class="section-label">About me</p>
        <h2 class="section-title">A developer who<br>keeps the lights on</h2>
        <p>
          I started as a junior developer at <strong>Tecno Electric</strong>, where I built a document management system from the ground up for clients in the chemical and pharmaceutical sector — database design, PHP backend, JavaScript frontend, end to end.
        </p>
        <p>
          Since 2025 I've taken on <strong>IT infrastructure</strong> responsibilities too: managing workstations, networks, and Windows systems company-wide. I enjoy the combination — shipping features in the morning and solving hardware issues in the afternoon.
        </p>
      </div>
      <div class="about-stats">
        <div class="stat-card card reveal reveal-delay-1">
          <div class="stat-number" data-count="3">0</div>
          <div class="stat-label">Years of professional experience</div>
        </div>
        <div class="stat-card card reveal reveal-delay-2">
          <div class="stat-number" data-count="2">0</div>
          <div class="stat-label">Roles held at Tecno Electric</div>
        </div>
        <div class="stat-card card reveal reveal-delay-3">
          <div class="stat-number">FS</div>
          <div class="stat-label">Full-stack — from DB to UI</div>
        </div>
        <div class="stat-card card reveal reveal-delay-4">
          <div class="stat-number">IT</div>
          <div class="stat-label">Infrastructure management</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- SKILLS -->
<section id="skills">
  <div class="container">
    <div class="section-head reveal">
      <p class="section-label">What I work with</p>
      <h2 class="section-title">Skills</h2>
    </div>
    <div class="skills-groups">
      <div class="skill-group card reveal reveal-delay-1">
        <h3>Advanced</h3>
        <div class="skill-tags">
          <span class="skill-tag advanced">PHP</span>
          <span class="skill-tag advanced">MySQL</span>
          <span class="skill-tag advanced">JavaScript</span>
        </div>
      </div>
      <div class="skill-group card reveal reveal-delay-2">
        <h3>Intermediate</h3>
        <div class="skill-tags">
          <span class="skill-tag intermediate">Next.js</span>
          <span class="skill-tag intermediate">TypeScript</span>
          <span class="skill-tag intermediate">Windows Systems</span>
          <span class="skill-tag intermediate">Networking</span>
        </div>
      </div>
      <div class="skill-group card reveal reveal-delay-3">
        <h3>Languages</h3>
        <div class="skill-tags">
          <span class="skill-tag lang">Italian — Native</span>
          <span class="skill-tag lang">English — Intermediate</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PROJECTS -->
<section id="projects">
  <div class="container">
    <div class="section-head reveal">
      <p class="section-label">What I've built</p>
      <h2 class="section-title">Projects</h2>
    </div>
    <div class="projects-grid">

      <article class="project-card card featured reveal" id="card-dms">
        <div class="project-header">
          <div class="project-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h8"/><path d="M8 9h2"/>
            </svg>
          </div>
          <div class="project-links">
            <span class="project-link project-status"><span class="status-dot"></span>Private — Live in production</span>
          </div>
        </div>
        <div class="project-body">
          <h3 class="project-title">Document Management System</h3>
          <p class="project-desc">
            A custom document management platform built from scratch for clients in the chemical and pharmaceutical sector. Handles document workflows, versioning, access control, and audit trails across multiple companies. Designed, built, and maintained solo over 3 years — currently in production.
          </p>
          <div class="project-tech">
            <span class="tech-badge">PHP</span>
            <span class="tech-badge">MySQL</span>
            <span class="tech-badge">JavaScript</span>
            <span class="tech-badge">HTML/CSS</span>
          </div>
        </div>
      </article>

      <article class="project-card card reveal reveal-delay-1" id="card-gametracker">
        <div class="project-header">
          <div class="project-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 11h4"/><path d="M8 9v4"/><path d="M15.5 12h.01"/><path d="M17.5 10h.01"/>
              <path d="M7.2 6h9.6c2.1 0 3.9 1.5 4.1 3.6l.7 6.1a2.8 2.8 0 0 1-4.8 2.2L15 16H9l-1.8 1.9a2.8 2.8 0 0 1-4.8-2.2l.7-6.1C3.3 7.5 5.1 6 7.2 6z"/>
            </svg>
          </div>
          <div class="project-links">
            <a href="https://github.com/marcoceci00/game-tracker" target="_blank" rel="noopener noreferrer" class="project-link">GitHub ↗</a>
          </div>
        </div>
        <div class="project-body">
          <h3 class="project-title">Game Tracker</h3>
          <p class="project-desc">
            A personal game library manager. Track your wishlist, backlog, currently playing, and completed games across PC, PlayStation, and Nintendo Switch. Pulls cover art and metadata from the IGDB API, supports ratings and notes per game.
          </p>
          <div class="project-tech">
            <span class="tech-badge">Next.js</span>
            <span class="tech-badge">TypeScript</span>
            <span class="tech-badge">Prisma</span>
            <span class="tech-badge">PostgreSQL</span>
            <span class="tech-badge">IGDB API</span>
            <span class="tech-badge">Tailwind CSS</span>
          </div>
        </div>
      </article>

      <article class="project-card card reveal reveal-delay-2" id="card-feldspato">
        <div class="project-header">
          <div class="project-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z"/>
              <path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/>
            </svg>
          </div>
          <div class="project-links">
            <a href="https://github.com/marcoceci00/feldspato" target="_blank" rel="noopener noreferrer" class="project-link">GitHub ↗</a>
          </div>
        </div>
        <div class="project-body">
          <h3 class="project-title">Feldspato</h3>
          <p class="project-desc">
            An IT support ticket management platform for companies. Designed to handle internal helpdesk workflows — creating, assigning, and tracking support requests across teams. Named after someone who wasn't afraid to go explore alone.
          </p>
          <div class="project-tech">
            <span class="tech-badge">Next.js</span>
            <span class="tech-badge">TypeScript</span>
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

<!-- CONTACT -->
<section id="contact">
  <div class="container">
    <div class="section-head center reveal">
      <p class="section-label">Get in touch</p>
      <h2 class="section-title">Let's work together</h2>
    </div>
    <div class="contact-card card reveal">
      <h3>Open to opportunities</h3>
      <p>Some things are better experienced than explained — but an email works too.</p>
      <div class="contact-links">
        <a href="mailto:marcoceci2010@gmail.com" class="btn btn-primary">Send an email</a>
        <a href="https://www.linkedin.com/in/marco-ceci-6661483a9" target="_blank" rel="noopener noreferrer" class="btn btn-outline">LinkedIn ↗</a>
        <a href="https://github.com/marcoceci00" target="_blank" rel="noopener noreferrer" class="btn btn-outline">GitHub ↗</a>
      </div>
    </div>
  </div>
</section>

</main>

<script is:inline>
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

/* ── PARTICLES ── */
(function () {
  const canvas = document.getElementById('hero-canvas');
  const ctx = canvas.getContext('2d');
  let W, H, particles;

  function resize() {
    W = canvas.width = canvas.offsetWidth;
    H = canvas.height = canvas.offsetHeight;
  }

  function Particle() {
    this.x = Math.random() * W;
    this.y = Math.random() * H;
    this.vx = (Math.random() - 0.5) * 0.4;
    this.vy = (Math.random() - 0.5) * 0.4;
    this.r = Math.random() * 1.8 + 0.6;
    this.alpha = Math.random() * 0.5 + 0.2;
  }

  Particle.prototype.update = function () {
    this.x += this.vx;
    this.y += this.vy;
    if (this.x < 0 || this.x > W) this.vx *= -1;
    if (this.y < 0 || this.y > H) this.vy *= -1;
  };

  function init() {
    resize();
    const count = Math.floor((W * H) / 9000);
    particles = Array.from({ length: count }, () => new Particle());
  }

  let animId;
  function drawFrame() {
    ctx.clearRect(0, 0, W, H);
    const len = particles.length;

    for (let i = 0; i < len; i++) {
      particles[i].update();
      const p = particles[i];
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(91,143,212,${p.alpha})`;
      ctx.fill();

      for (let j = i + 1; j < len; j++) {
        const q = particles[j];
        const dx = p.x - q.x, dy = p.y - q.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 130) {
          ctx.beginPath();
          ctx.moveTo(p.x, p.y);
          ctx.lineTo(q.x, q.y);
          ctx.strokeStyle = `rgba(91,143,212,${0.12 * (1 - dist / 130)})`;
          ctx.lineWidth = 0.8;
          ctx.stroke();
        }
      }
    }
  }
  function draw() {
    drawFrame();
    animId = requestAnimationFrame(draw);
  }

  init();
  window.addEventListener('resize', () => { init(); if (reduceMotion) drawFrame(); });

  if (reduceMotion) {
    drawFrame(); // one static frame, no animation
    return;
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) cancelAnimationFrame(animId);
    else animId = requestAnimationFrame(draw);
  });
  draw();
})();

/* ── TYPEWRITER ── */
(function () {
  const roles = [
    'Web Developer',
    'IT Specialist',
    'PHP Developer',
    'Next.js Developer',
    'Full-Stack Dev',
    'Curious Explorer',
  ];
  const el = document.getElementById('typewriter');

  if (reduceMotion) { el.textContent = roles[0]; return; }

  let ri = 0, ci = 0, deleting = false;

  function tick() {
    const word = roles[ri];
    el.textContent = deleting ? word.slice(0, ci--) : word.slice(0, ci++);

    let delay = deleting ? 60 : 100;
    if (!deleting && ci > word.length) { delay = 1800; deleting = true; }
    else if (deleting && ci < 0)      { ci = 0; deleting = false; ri = (ri + 1) % roles.length; delay = 300; }

    setTimeout(tick, delay);
  }
  setTimeout(tick, 1200);
})();

/* ── ACTIVE NAV ── */
(function () {
  const sections = ['about', 'skills', 'projects', 'contact'];
  const links = document.querySelectorAll('.nav-links a');

  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        links.forEach(a => a.classList.toggle('active', a.dataset.section === e.target.id));
      }
    });
  }, { threshold: 0.4 });

  sections.forEach(id => {
    const el = document.getElementById(id);
    if (el) obs.observe(el);
  });
})();

/* ── SCROLL REVEAL ── */
(function () {
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
    });
  }, { threshold: 0.12 });

  document.querySelectorAll('.reveal').forEach(el => obs.observe(el));
})();

/* ── COUNTER ANIMATION ── */
(function () {
  const counters = document.querySelectorAll('[data-count]');
  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target;
      const target = +el.dataset.count;
      let start = 0;
      const step = Math.ceil(target / 30);
      const t = setInterval(() => {
        start = Math.min(start + step, target);
        el.textContent = start + '+';
        if (start >= target) clearInterval(t);
      }, 40);
      obs.unobserve(el);
    });
  }, { threshold: 0.5 });

  counters.forEach(el => obs.observe(el));
})();

/* ── CARD TILT (skipped on touch devices and reduced motion) ── */
(function () {
  if (reduceMotion || !window.matchMedia('(pointer: fine)').matches) return;

  document.querySelectorAll('.project-card').forEach(card => {
    card.addEventListener('mousemove', e => {
      const rect = card.getBoundingClientRect();
      const x = (e.clientX - rect.left) / rect.width  - 0.5;
      const y = (e.clientY - rect.top)  / rect.height - 0.5;
      card.style.transform = `perspective(800px) rotateY(${x * 6}deg) rotateX(${-y * 6}deg) scale(1.015)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = '';
      card.style.transition = 'transform 0.5s cubic-bezier(0.22, 1, 0.36, 1)';
      setTimeout(() => card.style.transition = '', 500);
    });
    card.addEventListener('mouseenter', () => {
      card.style.transition = 'transform 0.1s ease';
    });
  });
})();

/* ── SKILL TAG STAGGER ── */
(function () {
  if (reduceMotion) return;

  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      e.target.querySelectorAll('.skill-tag').forEach((tag, i) => {
        tag.style.opacity = '0';
        tag.style.transform = 'translateY(12px)';
        setTimeout(() => {
          tag.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
          tag.style.opacity = '1';
          tag.style.transform = '';
        }, i * 80);
      });
      obs.unobserve(e.target);
    });
  }, { threshold: 0.3 });

  document.querySelectorAll('.skill-group').forEach(g => obs.observe(g));
})();
</script>
</Layout>
